<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="koto"
        Arguments=""
        InstallLocation="C:\Program Files\koto\koto">
    </Installer>
    <PackageInformation
        PackageName="koto"
        PackageDisplayName="koto"
        PublisherName="CN=koto"
        PublisherDisplayName="koto"
        Version="0.1.0.0"
        PackageDescription="Continue a coding-agent session in another agent">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="app.koto.desktop"
                Description="Continue a coding-agent session in another agent"
                DisplayName="koto"
                ExecutableName="koto"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>koto</DisplayName>
            <PublisherDisplayName>koto</PublisherDisplayName>
            <Description>Continue a coding-agent session in another agent</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="koto.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
